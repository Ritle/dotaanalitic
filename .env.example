# Local development only. Change credentials before exposing any service.
NODE_ENV=development
POSTGRES_DB=dota_analytics
POSTGRES_USER=dota
POSTGRES_PASSWORD=replace-this-dev-password
DATABASE_URL=postgresql://dota:replace-this-dev-password@localhost:5432/dota_analytics
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
# Optional in local HTTP development (otherwise random per process).
# Required >=32 random characters in production with HTTPS WEB_ORIGIN.
AUTH_COOKIE_SECRET=
VITE_API_BASE_URL=/api/v1
OPENDOTA_BASE_URL=https://api.opendota.com/api
# Leave unset unless using API key; never expose in VITE_ variables.
OPENDOTA_API_KEY=
OPENDOTA_RPM_BUDGET=45
# Shared PostgreSQL quotas apply to worker, spike and live audit. Windows reset in UTC.
OPENDOTA_DAILY_BUDGET=2000
OPENDOTA_MONTHLY_BUDGET=45000
# Optional server-side schedule source for the upcoming screen and manual schedule:audit.
# Create a token in the PandaScore dashboard. Never expose it through VITE_ variables.
PANDASCORE_API_TOKEN=
# Owner is NOT created from env. Use pnpm owner:create in a local terminal.
