{
  "name": "dota2-pro-analytics",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm shared:build && pnpm --parallel --filter @dota/api --filter @dota/web dev",
    "shared:build": "pnpm --filter @dota/ingestion... --filter @dota/contracts --if-present build",
    "worker:dev": "pnpm shared:build && pnpm --filter @dota/worker dev",
    "ingest:enqueue": "pnpm shared:build && pnpm --filter @dota/worker queue",
    "ingest:once": "pnpm shared:build && pnpm --filter @dota/worker once",
    "test:ingestion": "pnpm shared:build && node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run packages/ingestion/tests/import.integration.test.ts apps/worker/tests/queue.integration.test.ts",
    "build": "pnpm --recursive --if-present build",
    "typecheck": "pnpm shared:build && pnpm --recursive typecheck",
    "test": "pnpm shared:build && pnpm --recursive --if-present test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "preflight": "node --env-file-if-exists=.env scripts/preflight.mjs",
    "provider:audit": "pnpm shared:build && node --env-file-if-exists=.env scripts/audit-prediction-sources.mjs",
    "preflight:strict": "node --env-file-if-exists=.env scripts/preflight.mjs --strict",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "verify:docs": "node scripts/check-doc-links.mjs",
    "test:fixtures": "node --test tests/node/*.test.mjs",
    "test:integration": "node --env-file-if-exists=.env --test tests/integration/*.test.mjs",
    "test:e2e": "pnpm shared:build && pnpm --filter @dota/web test:e2e",
    "smoke": "node scripts/smoke-test.mjs",
    "lockfile:bootstrap": "node scripts/bootstrap-lockfile.mjs",
    "provider:spike": "pnpm shared:build && pnpm --filter @dota/api provider:spike",
    "owner:create": "pnpm shared:build && pnpm --filter @dota/api owner:create",
    "owner:reset": "pnpm shared:build && pnpm --filter @dota/api owner:reset",
    "test:auth": "pnpm shared:build && node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run apps/api/tests/auth.integration.test.ts",
    "test:temporal": "pnpm shared:build && node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run packages/db/tests/context.integration.test.ts",
    "test:identity": "pnpm shared:build && node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run packages/db/tests/identity.integration.test.ts",
    "test:game-context": "pnpm shared:build && node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run packages/db/tests/game-context.integration.test.ts",
    "test:dataset": "pnpm shared:build && node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run packages/db/tests/dataset.integration.test.ts",
    "test:readiness": "pnpm shared:build && node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run packages/db/tests/readiness.integration.test.ts",
    "test:catalog": "pnpm shared:build && node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run apps/api/tests/catalog.integration.test.ts",
    "test:pro-maps": "pnpm shared:build && node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run apps/api/tests/pro-maps.integration.test.ts",
    "test:roster": "pnpm shared:build && node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run apps/api/tests/roster.integration.test.ts",
    "test:player-hero": "pnpm shared:build && node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run apps/api/tests/player-hero.integration.test.ts",
    "test:strength": "pnpm shared:build && node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run apps/api/tests/strength.integration.test.ts",
    "test:sample": "pnpm shared:build && node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run apps/api/tests/sample.integration.test.ts",
    "test:patch-history": "pnpm shared:build && node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run packages/db/tests/patch-history.integration.test.ts",
    "patch:history": "pnpm shared:build && node --env-file-if-exists=.env scripts/patch-history.mjs",
    "patch:sources": "pnpm shared:build && node scripts/audit-patch-sources.mjs",
    "patch:archive": "pnpm shared:build && node scripts/audit-patch-archive.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "pg": "^8.16.0"
  }
}
