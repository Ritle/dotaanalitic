{
  "name": "dota2-pro-analytics",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @dota/api --filter @dota/web dev",
    "build": "pnpm --filter @dota/api --filter @dota/web build",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive --if-present test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "preflight": "node scripts/preflight.mjs",
    "preflight:strict": "node scripts/preflight.mjs --strict",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "verify:docs": "node scripts/check-doc-links.mjs",
    "test:fixtures": "node --test tests/node/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:e2e": "pnpm --filter @dota/web test:e2e",
    "smoke": "node scripts/smoke-test.mjs",
    "lockfile:bootstrap": "node scripts/bootstrap-lockfile.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "pg": "^8.16.0"
  }
}
