    "barrels": [
      {
        "path": "packages/contracts/dist/index.js",
        "text": "import { z } from 'zod';\nexport * from './temporal.js';\nexport * from './identity.js';\nexport * from './game-context.js';\nexport * from './dataset.js';\nexport * from './readiness.js';\nexport * from './catalog.js';\nexport * from './pro-maps.js';\n// API-facing BIGINT identifiers travel as strings; do not coerce via Number.\nexport const IdSchema = z.string().regex(/^[1-9]\\d*$/);\nexport const SideSchema = z.enum(['radiant', 'dire']);\nexport const StageSchema = z.enum(['pre_match', 'post_draft']);\nexport const ScenarioSlotSchema = z.enum(['A', 'B']);\nexport const PredictionStatusSchema = z.enum(['pending', 'running', 'done', 'failed', 'unavailable']);\nexport const StatResultSchema = z.object({\n    games: z.number().int().nonnegative(),\n    wins: z.number().int().nonnegative(),\n    winRate: z.number().min(0).max(1).nullable(),\n    updatedAt: z.string().datetime().nullable(),\n    warnings: z.array(z.string())\n}).refine(value => value.wins <= value.games);\nexport const CreateScenarioSchema = z.object({\n    teamAId: IdSchema,\n    teamBId: IdSchema,\n    cutoffAt: z.string().datetime(),\n    scheduledAt: z.string().datetime().optional(),\n    radiantSlot: ScenarioSlotSchema.nullable().optional()\n}).refine(value => value.teamAId !== value.teamBId, { message: 'Teams must differ' });\nexport const OwnerLoginSchema = z.string().trim().toLowerCase().regex(/^[a-z0-9_.-]{3,120}$/);\nexport const OwnerPasswordSchema = z.string().min(12).max(128);\nexport const LoginSchema = z.object({ login: OwnerLoginSchema, password: z.string().min(1).max(128) }).strict();\nexport const OwnerSchema = z.object({ id: z.uuid(), login: OwnerLoginSchema });\nexport const AuthResponseSchema = z.object({\n    owner: OwnerSchema,\n    expiresAt: z.iso.datetime(),\n    csrfToken: z.string().min(1).max(512)\n});\nexport * from './roster.js';\nexport * from './player-hero.js';\nexport * from './strength.js';\nexport * from './sample.js';\nexport * from './patch-history.js';\nexport * from './compare.js';\nexport * from './scenario.js';\nexport * from './draft.js';\nexport * from './hero-matchups.js';\nexport * from './scenario-report.js';\nexport * from './dataset-build.js';\nexport * from './corpus-audit.js';\nexport * from './corpus-quality.js';\nexport * from './series-provision.js';\nexport * from './dataset-audit.js';\nexport * from './identity-provision.js';\nexport * from './upcoming.js';\nexport * from './upcoming-evidence.js';\nexport * from './history-refresh.js';\nexport * from './patch-diagnostics.js';\nexport * from './prospective-patch.js';\nexport * from './research-elo.js';\nexport * from './research-plan.js';\nexport * from './v1-data.js';\nexport * from './research-execution.js';\nexport * from './v1-release-plan.js';\nexport * from './evaluation-discovery.js';\nexport * from './evaluation-details.js';\nexport * from './research-evidence.js';\nexport * from './research-journal.js';\nexport * from './v1-features.js';\nexport * from './v1-candidate.js';\nexport * from './v1-release-evidence.js';\nexport * from './v1-release-evaluation.js';\nexport * from './v1-executable-freeze.js';\nexport * from './v1-registry.js';\nexport * from './v1-runtime.js';\nexport * from './v1-forecast.js';\nexport * from './v1-journal.js';\nexport * from './v1-journal-view.js';\nexport * from './v1-prediction-view.js';\nexport * from './v1-target-lifecycle.js';\nexport * from './v1-journal-v2.js';\n"
      },
      {
        "path": "packages/analytics/dist/index.js",
        "text": "export function winRate(records) {\n    const games = records.length;\n    const wins = records.filter(row => row.won).length;\n    return { games, wins, winRate: games === 0 ? null : wins / games };\n}\nexport function aggregateKda(records) {\n    if (records.length === 0)\n        return null;\n    const killsAndAssists = records.reduce((sum, row) => sum + row.kills + row.assists, 0);\n    const deaths = records.reduce((sum, row) => sum + row.deaths, 0);\n    return killsAndAssists / Math.max(1, deaths);\n}\n/** Stable unordered hero pair key (hero IDs are safe positive 32-bit ints). */\nexport function allyHeroPairKey(a, b) {\n    if (a === b)\n        throw new Error('A hero cannot be paired with itself');\n    if (!Number.isInteger(a) || !Number.isInteger(b) || a <= 0 || b <= 0)\n        throw new Error('Invalid hero ID');\n    return `${Math.min(a, b)}:${Math.max(a, b)}`;\n}\nexport function enemyMatchupKey(heroA, heroB) {\n    if (heroA === heroB)\n        throw new Error('Duplicate hero in same match');\n    return `${heroA}:${heroB}`;\n}\nexport { rosterOverlap, rosterCoplay } from './roster.js';\nexport { describeRoster, compareRosters, describeChurn } from './roster-report.js';\nexport { playerHeroSample } from './player-hero.js';\nexport { predictLogistic } from './model-inference.js';\nexport { replayElo, ELO_POLICY } from './elo.js';\nexport { sampleEvidence, weightedSample, shrinkObservedRate } from './sample.js';\nexport { historyWeight, historyWeightSummary } from './history-weight.js';\nexport { pairObservations } from './hero-pairs.js';\nexport { heroMetaSample } from './hero-meta.js';\nexport { forecastMetrics, FORECAST_METRIC_POLICY, FORECAST_LOG_LOSS_CLIP } from './forecast-metrics.js';\n"
      },
