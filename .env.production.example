# Copy to .env.production. NEVER commit .env.production.
# Replace example domain with your own domain; use .env for native localhost development.
SITE_HOST=analytics.example.com
POSTGRES_DB=dota_analytics
POSTGRES_USER=dota
POSTGRES_PASSWORD=change-me-to-a-long-random-secret
DATABASE_URL=postgresql://dota:change-me-to-a-long-random-secret@postgres:5432/dota_analytics
NODE_ENV=production
API_PORT=3000
API_HOST=0.0.0.0
WEB_ORIGIN=https://analytics.example.com
# REQUIRED: >=32 cryptographically random characters; no default value.
AUTH_COOKIE_SECRET=
# Optional, server-side API only. Empty token leaves fresh schedule unavailable.
PANDASCORE_API_TOKEN=
ROLE_PROFILES_ENABLED=false
STRATZ_API_TOKEN=
OPENDOTA_API_KEY=
OPENDOTA_RPM_BUDGET=45
OPENDOTA_DAILY_BUDGET=2000
OPENDOTA_MONTHLY_BUDGET=45000
