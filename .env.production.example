# Copy to .env.production. NEVER commit .env.production.
# Mandatory publicly resolvable domain for automatic HTTPS (or localhost for local-only experiment).
SITE_HOST=analytics.example.com
POSTGRES_DB=dota_analytics
POSTGRES_USER=dota
POSTGRES_PASSWORD=change-me-to-a-long-random-secret
DATABASE_URL=postgresql://dota:change-me-to-a-long-random-secret@postgres:5432/dota_analytics
NODE_ENV=production
API_PORT=3000
API_HOST=0.0.0.0
WEB_ORIGIN=https://analytics.example.com
OPENDOTA_API_KEY=
