{
  "name": "@dota/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --exclude **/*.integration.test.ts",
    "provider:spike": "tsx --env-file-if-exists=../../.env src/providers/opendota/spike.ts",
    "owner:create": "tsx --env-file-if-exists=../../.env src/modules/auth/owner-cli.ts create",
    "owner:reset": "tsx --env-file-if-exists=../../.env src/modules/auth/owner-cli.ts reset"
  },
  "dependencies": {
    "@dota/contracts": "workspace:*",
    "@dota/db": "workspace:*",
    "@dota/ingestion": "workspace:*",
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "^11.1.0",
    "@fastify/csrf-protection": "8.0.2",
    "@fastify/rate-limit": "11.2.1",
    "argon2": "0.45.1",
    "fastify": "^5.6.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
